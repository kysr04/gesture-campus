# 本地验证用的浏览器配置目录，别提交
work/.chrome-profile/
# 临时下载的隧道工具
work/cloudflared.exe
# 验证产出的截图
work/**/*.png
# 本地服务器的日志
work/*.log
# 命令行发布工具的依赖，几十兆，不入库
work/deploy/node_modules/
work/deploy/.wrangler/
# 部署产物是构建输出，不入库（否则 7.8MB 的模型会在仓库里存两份）
dist/
# wrangler 在项目根目录跑过一次留下的缓存，可能含账号信息，不入库
.wrangler/
# Python 字节码
__pycache__/
*.pyc
# 这两份是根目录同名文件的副本，只留一份（根目录那份才是要部署的）
work/hand_landmarker.task
work/campus/campus.json
